{
    "name": "open-in-browser",
    "displayName": "Open in Browser",
    "description": "Open the current file in your default browser or another installed browser. Cursor-ready fork.",
    "icon": "images/icon.png",
    "version": "3.0.0",
    "publisher": "cloudo",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/Cloudo/cursor-extensions-open-in-browser.git"
    },
    "bugs": {
        "url": "https://github.com/Cloudo/cursor-extensions-open-in-browser/issues"
    },
    "engines": {
        "vscode": "^1.75.0"
    },
    "categories": [
        "Other"
    ],
    "keywords": [
        "open",
        "html",
        "browser",
        "cursor"
    ],
    "extensionKind": [
        "ui",
        "workspace"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        },
        "virtualWorkspaces": {
            "supported": false,
            "description": "The file has to exist on disk to be opened by a browser."
        }
    },
    "main": "./out/extension",
    "contributes": {
        "commands": [
            {
                "command": "open-in-browser.openInDefaultBrowser",
                "title": "Open In Default Browser",
                "category": "Open in Browser"
            },
            {
                "command": "open-in-browser.openInSpecifyBrowser",
                "title": "Open In Other Browsers",
                "category": "Open in Browser"
            }
        ],
        "configuration": {
            "type": "object",
            "title": "Open in Browser",
            "properties": {
                "open-in-browser.default": {
                    "type": "string",
                    "default": "",
                    "description": "Set default browser: chrome, firefox, edge, safari, opera, chromium, ie, firefox developer edition. Empty means the system default browser."
                },
                "open-in-browser.showForAllFiles": {
                    "type": "boolean",
                    "default": false,
                    "description": "Show the context menu items for every file, not only for html."
                }
            }
        },
        "keybindings": [
            {
                "command": "open-in-browser.openInSpecifyBrowser",
                "key": "shift+alt+B"
            },
            {
                "command": "open-in-browser.openInDefaultBrowser",
                "key": "Alt+B"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "when": "resourceLangId == html || config.open-in-browser.showForAllFiles",
                    "command": "open-in-browser.openInDefaultBrowser",
                    "group": "open-in-browser"
                },
                {
                    "when": "resourceLangId == html || config.open-in-browser.showForAllFiles",
                    "command": "open-in-browser.openInSpecifyBrowser",
                    "group": "open-in-browser"
                }
            ],
            "editor/context": [
                {
                    "when": "resourceLangId == html || config.open-in-browser.showForAllFiles",
                    "command": "open-in-browser.openInDefaultBrowser",
                    "group": "open-in-browser"
                },
                {
                    "when": "resourceLangId == html || config.open-in-browser.showForAllFiles",
                    "command": "open-in-browser.openInSpecifyBrowser",
                    "group": "open-in-browser"
                }
            ],
            "editor/title/context": [
                {
                    "when": "resourceLangId == html || config.open-in-browser.showForAllFiles",
                    "command": "open-in-browser.openInDefaultBrowser",
                    "group": "open-in-browser"
                },
                {
                    "when": "resourceLangId == html || config.open-in-browser.showForAllFiles",
                    "command": "open-in-browser.openInSpecifyBrowser",
                    "group": "open-in-browser"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "vsce package",
        "install-cursor": "npm run package && cursor --install-extension open-in-browser-$npm_package_version.vsix --force"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/vscode": "^1.75.0",
        "@vscode/vsce": "^3.6.0",
        "typescript": "^5.9.0"
    },
    "dependencies": {
        "open": "^8.4.2"
    }
}
